// Klistra in reglerna nedan i Firebase Console → Firestore Database → Rules.
// En inloggad användare får bara läsa och skriva sitt eget dokument
// under users/{userId}, där userId är request.auth.uid.
// Alla andra sökvägar är stängda.
//
// rules_version = '2';
// service cloud.firestore {
//   match /databases/{database}/documents {
//     match /users/{userId} {
//       allow read, write: if request.auth != null && request.auth.uid == userId;
//     }
//   }
// }

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
